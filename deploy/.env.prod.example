# Salin jadi .env.prod lalu isi nilainya (JANGAN commit).

# Domain public untuk website (Next.js)
WEB_BASE_URL=https://example.com

# CORS origins untuk backend (kalau backend diakses langsung oleh browser).
# Kalau semua request lewat Next.js (/api) biasanya cukup set ke domain web.
CORS_ORIGINS=https://example.com

# Secrets (wajib ganti)
POSTGRES_PASSWORD=change-me-strong
ADMIN_API_KEY=change-me-strong
ADMIN_PASSWORD=change-me-strong
ADMIN_JWT_SECRET=change-me-strong

# API key provider (kalau dipakai)
TWELVE_DATA_API_KEY=change-me
