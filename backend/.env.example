NODE_ENV=development
HTTP_PORT=4000
WEB_BASE_URL=http://localhost:3000

POSTGRES_URL=postgres://tickr:tickr@localhost:5432/tickr

REDIS_URL=redis://localhost:6379

SERVICE_ROLE=all
POLL_INTERVAL_MS=3000

# Admin protection for sensitive endpoints (devices list + symbols upload)
# Requests must include header: x-admin-key: <ADMIN_API_KEY>
ADMIN_API_KEY=youvandra

TWELVE_DATA_API_KEY=16a861f20b05418e9073ec843a3cffc8
TWELVE_CACHE_SECONDS=120

# Comma-separated list of browser origins allowed to call this backend (CORS).
# Use "*" to allow all (not recommended for production).
CORS_ORIGINS=http://localhost:3000

# Optional debug logs (set to 1 to enable)
LOG_SERIES_REQUESTS=0
LOG_MARKET_POLLS=0
